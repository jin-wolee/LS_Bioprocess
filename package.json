    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
