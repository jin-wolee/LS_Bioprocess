#!/usr/bin/env bash
# git pre-commit: refuse banned tokens and private paths in the staged changes.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: 'uv' is not on PATH, so the staged-content check cannot run. Refusing to commit (install uv or fix PATH)." >&2
  exit 1
fi
exec uv run --frozen --quiet python scripts/check_docs.py --staged
