{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "One line of the canonical event log: the L3 event types of docs/design/simulation_spec.md section 2.3 and a log_header that binds schema_version, engine_version and seed to the log. t is an integer second from scenario t0. Fields annotated x-visibility hidden exist in the truth log only and never reach a recorder. S1b adds the L1 and L2 types and the instrument calibration record additively.",
  "oneOf": [
    { "$ref": "#/$defs/log_header" },
    { "$ref": "#/$defs/request_queued" },
    { "$ref": "#/$defs/visit_started" },
    { "$ref": "#/$defs/run_started" },
    { "$ref": "#/$defs/result_measured" },
    { "$ref": "#/$defs/qc_result" },
    { "$ref": "#/$defs/visit_finished" },
    { "$ref": "#/$defs/rerun_requested" },
    { "$ref": "#/$defs/dilution_applied" },
    { "$ref": "#/$defs/qc_window_started" },
    { "$ref": "#/$defs/qc_window_ended" },
    { "$ref": "#/$defs/maintenance_started" },
    { "$ref": "#/$defs/maintenance_ended" },
    { "$ref": "#/$defs/inoculation" },
    { "$ref": "#/$defs/process_event" },
    { "$ref": "#/$defs/sensor_tick" },
    { "$ref": "#/$defs/sample_planned" },
    { "$ref": "#/$defs/sample_drawn" },
    { "$ref": "#/$defs/label_bound" },
    { "$ref": "#/$defs/sample_received" },
    { "$ref": "#/$defs/aliquot_created" },
    { "$ref": "#/$defs/draw_skipped_volume_budget" },
    { "$ref": "#/$defs/calibration_recorded" },
    { "$ref": "#/$defs/contamination_onset" },
    { "$ref": "#/$defs/signal_observed" },
    { "$ref": "#/$defs/deviation_opened" },
    { "$ref": "#/$defs/confirm_sample_drawn" },
    { "$ref": "#/$defs/confirm_result" }
  ],
  "$defs": {
    "time": { "type": "integer", "minimum": 0 },
    "ident": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 1 },
    "log_header": {
      "title": "LogHeader",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "schema_version", "engine_version", "seed"],
      "properties": {
        "type": { "type": "string", "const": "log_header" },
        "t": { "type": "integer", "const": 0 },
        "schema_version": { "type": "string", "const": "1" },
        "engine_version": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "request_queued": {
      "title": "RequestQueued",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "request_id", "attempt", "visit", "group", "seq"],
      "properties": {
        "type": { "type": "string", "const": "request_queued" },
        "t": { "$ref": "#/$defs/time" },
        "request_id": { "$ref": "#/$defs/ident" },
        "attempt": { "$ref": "#/$defs/count" },
        "visit": { "$ref": "#/$defs/count" },
        "group": { "$ref": "#/$defs/ident" },
        "seq": { "type": "integer", "minimum": 0 }
      }
    },
    "visit_started": {
      "title": "VisitStarted",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "request_id", "attempt", "visit", "analyzer", "setup_s"],
      "properties": {
        "type": { "type": "string", "const": "visit_started" },
        "t": { "$ref": "#/$defs/time" },
        "request_id": { "$ref": "#/$defs/ident" },
        "attempt": { "$ref": "#/$defs/count" },
        "visit": { "$ref": "#/$defs/count" },
        "analyzer": { "$ref": "#/$defs/ident" },
        "setup_s": { "$ref": "#/$defs/time" }
      }
    },
    "run_started": {
      "title": "RunStarted",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "request_id", "attempt", "visit", "analyzer"],
      "properties": {
        "type": { "type": "string", "const": "run_started" },
        "t": { "$ref": "#/$defs/time" },
        "request_id": { "$ref": "#/$defs/ident" },
        "attempt": { "$ref": "#/$defs/count" },
        "visit": { "$ref": "#/$defs/count" },
        "analyzer": { "$ref": "#/$defs/ident" }
      }
    },
    "result_measured": {
      "title": "ResultMeasured",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "request_id", "attempt", "visit", "analyzer", "analyte", "value", "true_value", "noise"],
      "properties": {
        "type": { "type": "string", "const": "result_measured" },
        "t": { "$ref": "#/$defs/time" },
        "request_id": { "$ref": "#/$defs/ident" },
        "attempt": { "$ref": "#/$defs/count" },
        "visit": { "$ref": "#/$defs/count" },
        "analyzer": { "$ref": "#/$defs/ident" },
        "analyte": { "$ref": "#/$defs/ident" },
        "value": { "type": "number" },
        "true_value": { "type": "number", "x-visibility": "hidden" },
        "noise": { "type": "number", "x-visibility": "hidden" },
        "stability_kind": { "type": "string", "enum": ["linear_rate", "first_order_offset"], "x-visibility": "hidden" },
        "stability_delta": { "type": "number", "x-visibility": "hidden" },
        "extrapolated": { "type": "boolean", "x-visibility": "hidden" }
      }
    },
    "qc_result": {
      "title": "QcResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "request_id", "attempt", "visit", "analyzer", "outcome"],
      "properties": {
        "type": { "type": "string", "const": "qc_result" },
        "t": { "$ref": "#/$defs/time" },
        "request_id": { "$ref": "#/$defs/ident" },
        "attempt": { "$ref": "#/$defs/count" },
        "visit": { "$ref": "#/$defs/count" },
        "analyzer": { "$ref": "#/$defs/ident" },
        "outcome": { "type": "string", "enum": ["qc_passed", "qc_failed", "over_range"] }
      }
    },
    "visit_finished": {
      "title": "VisitFinished",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "request_id", "attempt", "visit", "analyzer"],
      "properties": {
        "type": { "type": "string", "const": "visit_finished" },
        "t": { "$ref": "#/$defs/time" },
        "request_id": { "$ref": "#/$defs/ident" },
        "attempt": { "$ref": "#/$defs/count" },
        "visit": { "$ref": "#/$defs/count" },
        "analyzer": { "$ref": "#/$defs/ident" }
      }
    },
    "rerun_requested": {
      "title": "RerunRequested",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "request_id", "attempt", "visit", "reason"],
      "properties": {
        "type": { "type": "string", "const": "rerun_requested" },
        "t": { "$ref": "#/$defs/time" },
        "request_id": { "$ref": "#/$defs/ident" },
        "attempt": { "$ref": "#/$defs/count" },
        "visit": { "$ref": "#/$defs/count" },
        "reason": { "type": "string", "enum": ["qc_failed", "over_range"] }
      }
    },
    "dilution_applied": {
      "title": "DilutionApplied",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "request_id", "attempt", "visit", "dilution_factor"],
      "properties": {
        "type": { "type": "string", "const": "dilution_applied" },
        "t": { "$ref": "#/$defs/time" },
        "request_id": { "$ref": "#/$defs/ident" },
        "attempt": { "$ref": "#/$defs/count" },
        "visit": { "$ref": "#/$defs/count" },
        "dilution_factor": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "qc_window_started": {
      "title": "QcWindowStarted",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "analyzer"],
      "properties": { "type": { "type": "string", "const": "qc_window_started" }, "t": { "$ref": "#/$defs/time" }, "analyzer": { "$ref": "#/$defs/ident" } }
    },
    "qc_window_ended": {
      "title": "QcWindowEnded",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "analyzer"],
      "properties": { "type": { "type": "string", "const": "qc_window_ended" }, "t": { "$ref": "#/$defs/time" }, "analyzer": { "$ref": "#/$defs/ident" } }
    },
    "maintenance_started": {
      "title": "MaintenanceStarted",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "analyzer"],
      "properties": { "type": { "type": "string", "const": "maintenance_started" }, "t": { "$ref": "#/$defs/time" }, "analyzer": { "$ref": "#/$defs/ident" } }
    },
    "maintenance_ended": {
      "title": "MaintenanceEnded",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "analyzer"],
      "properties": { "type": { "type": "string", "const": "maintenance_ended" }, "t": { "$ref": "#/$defs/time" }, "analyzer": { "$ref": "#/$defs/ident" } }
    },
    "inoculation": {
      "title": "Inoculation",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "unit_id", "batch_id", "density_e6_per_ml"],
      "properties": {
        "type": { "type": "string", "const": "inoculation" },
        "t": { "$ref": "#/$defs/time" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" },
        "density_e6_per_ml": { "type": "number", "exclusiveMinimum": 0 },
        "seed_lot_id": { "$ref": "#/$defs/ident", "description": "The seed lot this inoculation consumes (break-out batch 2, spec 11.8.5). Present only for a unit named in the topology of a break-out block; absent in every other scenario." }
      }
    },
    "process_event": {
      "title": "ProcessEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "unit_id", "batch_id", "kind", "source"],
      "properties": {
        "type": { "type": "string", "const": "process_event" },
        "t": { "$ref": "#/$defs/time" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" },
        "kind": { "type": "string", "enum": ["feed", "temperature_shift", "alarm", "harvest", "medium_addition", "equipment_use", "unit_stopped"] },
        "source": { "type": "string", "enum": ["rule", "scheduled", "scripted"] },
        "amount": { "type": "number" },
        "amount_unit": { "type": "string", "minLength": 1 },
        "lot_id": { "$ref": "#/$defs/ident", "description": "The medium lot a medium_addition consumes (break-out batch 2)." },
        "equipment_id": { "$ref": "#/$defs/ident", "description": "The shared equipment item an equipment_use uses (break-out batch 2)." }
      }
    },
    "sensor_tick": {
      "title": "SensorTick",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "unit_id", "signal", "value", "true_value"],
      "properties": {
        "type": { "type": "string", "const": "sensor_tick" },
        "t": { "$ref": "#/$defs/time" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "signal": { "type": "string", "enum": ["pH", "DO", "temperature"] },
        "value": { "type": "number" },
        "true_value": { "type": "number", "x-visibility": "hidden" }
      }
    },
    "sample_planned": {
      "title": "SamplePlanned",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "sample_id", "unit_id", "batch_id"],
      "properties": {
        "type": { "type": "string", "const": "sample_planned" },
        "t": { "$ref": "#/$defs/time" },
        "sample_id": { "$ref": "#/$defs/ident" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" }
      }
    },
    "sample_drawn": {
      "title": "SampleDrawn",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "sample_id", "unit_id", "batch_id", "operator_id", "volume_ul", "true_state"],
      "properties": {
        "type": { "type": "string", "const": "sample_drawn" },
        "t": { "$ref": "#/$defs/time" },
        "sample_id": { "$ref": "#/$defs/ident" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" },
        "operator_id": { "$ref": "#/$defs/ident" },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0 },
        "true_state": { "type": "object", "additionalProperties": { "type": "number" }, "x-visibility": "hidden" }
      }
    },
    "label_bound": {
      "title": "LabelBound",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "sample_id", "method"],
      "properties": {
        "type": { "type": "string", "const": "label_bound" },
        "t": { "$ref": "#/$defs/time" },
        "sample_id": { "$ref": "#/$defs/ident" },
        "method": { "type": "string", "enum": ["handwritten", "preprinted_barcode", "issued_at_draw"] }
      }
    },
    "sample_received": {
      "title": "SampleReceived",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "sample_id"],
      "properties": {
        "type": { "type": "string", "const": "sample_received" },
        "t": { "$ref": "#/$defs/time" },
        "sample_id": { "$ref": "#/$defs/ident" }
      }
    },
    "aliquot_created": {
      "title": "AliquotCreated",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "sample_id", "aliquot_id", "storage", "volume_ul"],
      "properties": {
        "type": { "type": "string", "const": "aliquot_created" },
        "t": { "$ref": "#/$defs/time" },
        "sample_id": { "$ref": "#/$defs/ident" },
        "aliquot_id": { "$ref": "#/$defs/ident" },
        "storage": { "type": "string", "enum": ["ice", "room_temperature", "frozen"] },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "draw_skipped_volume_budget": {
      "title": "DrawSkippedVolumeBudget",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "sample_id", "unit_id", "batch_id", "volume_ul", "cumulative_ul"],
      "properties": {
        "type": { "type": "string", "const": "draw_skipped_volume_budget" },
        "t": { "$ref": "#/$defs/time" },
        "sample_id": { "$ref": "#/$defs/ident" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0 },
        "cumulative_ul": { "type": "number", "minimum": 0 }
      }
    },
    "calibration_recorded": {
      "title": "CalibrationRecorded",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "analyzer", "lot_id", "drift_before_pct"],
      "properties": {
        "type": { "type": "string", "const": "calibration_recorded" },
        "t": { "$ref": "#/$defs/time" },
        "analyzer": { "$ref": "#/$defs/ident" },
        "lot_id": { "$ref": "#/$defs/ident" },
        "drift_before_pct": { "type": "number", "x-visibility": "hidden" }
      }
    },
    "contamination_onset": {
      "title": "ContaminationOnset",
      "description": "Truth only (spec 11.8.2 rule S6): the instant a unit becomes contaminated, with the type and the origin. The whole event is hidden: observe() drops its type, so no recorder ever reads it; only the evaluator does. For a sampling origin origin_id is the sample id of the named draw; for a unit's own equipment it is the unit id.",
      "x-visibility": "hidden",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "unit_id", "batch_id", "contamination_type", "origin_kind", "origin_id"],
      "properties": {
        "type": { "type": "string", "const": "contamination_onset" },
        "t": { "$ref": "#/$defs/time" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" },
        "contamination_type": { "$ref": "#/$defs/ident" },
        "origin_kind": { "type": "string", "enum": ["seed_lot", "medium_lot", "shared_equipment", "unit_equipment", "sampling"] },
        "origin_id": { "$ref": "#/$defs/ident" }
      }
    },
    "signal_observed": {
      "title": "SignalObserved",
      "description": "The first process signal of a unit (spec 11.4): the instant the true value of the signal reaches its alarm limit (11.8.2 rule S1). Observable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "unit_id", "batch_id", "signal", "limit"],
      "properties": {
        "type": { "type": "string", "const": "signal_observed" },
        "t": { "$ref": "#/$defs/time" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" },
        "signal": { "type": "string", "enum": ["pH", "DO", "temperature"] },
        "limit": { "type": "string", "enum": ["low", "high"] }
      }
    },
    "deviation_opened": {
      "title": "DeviationOpened",
      "description": "One deviation per break-out event, opened at the first signal (11.8.2 rule S2). unit_id and batch_id are those of the signalling unit. Observable; the written record (estimated onset, assumed lag) is made by the investigation on the recorded side.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "deviation_id", "unit_id", "batch_id", "trigger"],
      "properties": {
        "type": { "type": "string", "const": "deviation_opened" },
        "t": { "$ref": "#/$defs/time" },
        "deviation_id": { "$ref": "#/$defs/ident" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" },
        "trigger": { "type": "string", "enum": ["signal"] }
      }
    },
    "confirm_sample_drawn": {
      "title": "ConfirmSampleDrawn",
      "description": "The one confirming sample of a unit, drawn at the first decision instant (11.8.2 rules S2, S3), with one aliquot per confirming test. volume_ul is the sum of the aliquot volumes. A draw that exceeds the volume budget is logged as draw_skipped_volume_budget instead. Observable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "sample_id", "unit_id", "batch_id", "operator_id", "volume_ul", "tests"],
      "properties": {
        "type": { "type": "string", "const": "confirm_sample_drawn" },
        "t": { "$ref": "#/$defs/time" },
        "sample_id": { "$ref": "#/$defs/ident" },
        "unit_id": { "$ref": "#/$defs/ident" },
        "batch_id": { "$ref": "#/$defs/ident" },
        "operator_id": { "$ref": "#/$defs/ident" },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0 },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aliquot_id", "test", "volume_ul"],
            "properties": {
              "aliquot_id": { "$ref": "#/$defs/ident" },
              "test": { "$ref": "#/$defs/ident" },
              "volume_ul": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "confirm_result": {
      "title": "ConfirmResult",
      "description": "The result of one confirming test, at the draw plus its turnaround (11.8.2 rule S3). The tests report the truth, so the outcome is observable as a result. No numeric value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "t", "sample_id", "aliquot_id", "test", "outcome"],
      "properties": {
        "type": { "type": "string", "const": "confirm_result" },
        "t": { "$ref": "#/$defs/time" },
        "sample_id": { "$ref": "#/$defs/ident" },
        "aliquot_id": { "$ref": "#/$defs/ident" },
        "test": { "$ref": "#/$defs/ident" },
        "outcome": { "type": "string", "enum": ["detected", "not_detected"] }
      }
    }
  }
}
