{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Profile",
  "description": "A bioreactor, analyzer or staff profile (data, not code). Every numeric parameter is {value, unit, ref}; ref resolves to a ledger id (ADR-0012). profile_id is a free string: ids of profiles are never enumerated in a schema or in generated types.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "kind", "params"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["bioreactor", "analyzer", "staff"] },
    "description": { "type": "string" },
    "bundle": { "type": "string", "pattern": "^A[0-9]{3}$", "description": "The ledger bundle this profile is (A065 to A073, ADR-0012): the lab reads the bundle grade from it. Data for the page; the engine does not read it." },
    "route": {
      "description": "Analyzer profiles: the visits of one sample, in order. Names in a stage refer to keys of params.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "containers": {
      "description": "Bioreactor profiles: sample container per analyte, with a default entry.",
      "type": "object",
      "additionalProperties": { "type": "string", "enum": ["open", "closed"] }
    },
    "params": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/param" }
    }
  },
  "$defs": {
    "stage": {
      "title": "Stage",
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "analytes", "service", "storage"],
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "analytes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/analyte" } },
        "service": { "type": "string", "minLength": 1 },
        "transfer": { "type": "string", "minLength": 1 },
        "method_id": { "type": "string", "minLength": 1 },
        "dialect": { "type": "string", "minLength": 1, "description": "The output dialect of the raw device layer that writes this visit (spec section 2.4.2); a key of scenarios/profiles/dialect/. Read only with raw_layer on." },
        "storage": { "type": "string", "enum": ["ice", "room_temperature", "frozen"] },
        "dilution_factors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "analyte": {
      "title": "Analyte",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "noise": { "type": "string", "minLength": 1 },
        "relative": { "type": "boolean" },
        "limit": { "type": "string", "minLength": 1 }
      }
    },
    "param": {
      "title": "Param",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "ref"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^A\\d{3}$|^S\\d{3}$" }
      }
    }
  }
}
