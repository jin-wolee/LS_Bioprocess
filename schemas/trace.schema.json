{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.schema.json",
  "title": "Trace",
  "description": "Input of a trace-driven core loop. All randomness is drawn in the TS engine and written here; the SimPy side is deterministic. Times are integer seconds from scenario t0 (day 0, 00:00:00). initial_method is the method installed on that analyzer at t0 (null = none, so the first run needs no setup). transfer_s is the transfer before a visit that is not the first. attempt and visit count from 1. expected_result and source are fixture metadata: examples carry them, engine exports do not, and the SimPy side ignores them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_version", "seed", "policy", "analyzers", "setup", "windows", "requests", "forced_outcomes"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "engine_version": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "policy": { "type": "string", "enum": ["fifo", "edf"] },
    "analyzers": {
      "type": "array",
      "description": "Order is the dispatch order: the lowest-index idle, available analyzer of a group takes the head.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "initial_method"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "initial_method": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "setup": {
      "type": "array",
      "description": "Sequence-dependent setup. A run whose method differs from the loaded one needs the pair listed here; an analyzer with no method loaded, or a visit without method_id, needs no setup.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_method", "to_method", "seconds"],
        "properties": {
          "from_method": { "type": "string", "minLength": 1 },
          "to_method": { "type": "string", "minLength": 1 },
          "seconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "windows": {
      "type": "array",
      "description": "Half-open [start_s, end_s) windows in which the analyzer is unavailable.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analyzer", "start_s", "end_s"],
        "properties": {
          "analyzer": { "type": "string", "minLength": 1 },
          "start_s": { "type": "integer", "minimum": 0 },
          "end_s": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "seq", "arrive_s", "visits"],
        "properties": {
          "request_id": { "type": "string", "minLength": 1 },
          "seq": { "type": "integer", "minimum": 0 },
          "arrive_s": { "type": "integer", "minimum": 0 },
          "deadline_s": { "type": "integer", "minimum": 0 },
          "visits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["group", "service_s"],
              "properties": {
                "group": { "type": "string", "minLength": 1 },
                "service_s": { "type": "integer", "minimum": 1 },
                "method_id": { "type": "string", "minLength": 1 },
                "transfer_s": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "forced_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "attempt", "visit", "outcome"],
        "properties": {
          "request_id": { "type": "string", "minLength": 1 },
          "attempt": { "type": "integer", "minimum": 1 },
          "visit": { "type": "integer", "minimum": 1 },
          "outcome": { "type": "string", "enum": ["qc_passed", "qc_failed", "over_range"] }
        }
      }
    },
    "expected_result": { "$ref": "trace_result.schema.json" },
    "source": { "type": "string", "enum": ["hand", "ts-engine-golden"] }
  }
}
